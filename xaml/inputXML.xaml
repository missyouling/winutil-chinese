                                       Foreground="{DynamicResource MainForegroundColor}"/>
                            <TextBlock Text="选择 Windows 接收更新的方式。每个配置将替换 WinUtil 管理的更新设置。"
                                       Margin="0,6,0,0"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MainForegroundColor}"/>
